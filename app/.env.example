# Copier ce fichier en app/.env (jamais commité).

# --- Sur le PC : adresse du serveur en ligne et jeton partagé ---
# Utilisés par l'agent (npm run agent) et par le bouton « Envoyer en ligne » de l'atelier local.
PUBLISH_URL=https://dtforget.example.com
PUBLISH_TOKEN=un-long-jeton-secret

# --- Sur le VPS (fichier .env à côté de compose.yml) ---
# PUBLIC_URL=https://dtforget.example.com
# IMPORT_TOKEN=un-long-jeton-secret
# ATELIER_PIN=un-code-pour-ouvrir-l-atelier
